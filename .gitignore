# Only the reviewed static publication tree and this allowlist may be committed.
/*
!/.gitignore
!/docs/
/docs/*
!/docs/index.html
!/docs/style.css
!/docs/app.mjs
!/docs/engine.mjs
!/docs/paper-app.mjs
!/docs/paper-engine.mjs
!/docs/paper-layout.mjs
!/docs/paper-pdf.mjs
!/docs/.nojekyll
!/docs/data/
/docs/data/*
!/docs/data/materials.json
